{
  "manifest_version": 3,
  "name": "GATE Offline Saver",
  "version": "1.0.0",
  "description": "Download GATE exam results and preparation pages as fully offline HTML/MHTML files with styling, math, and images intact.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "pageCapture",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save GATE Page Offline"
  }
}
